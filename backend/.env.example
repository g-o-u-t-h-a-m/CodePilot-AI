# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true

# API Configuration
API_VERSION=v1
API_TITLE=CodePilot AI
API_DESCRIPTION=AI-powered code assistant

# ---------------------------------------------------------------------------
# LLM / Generation Configuration (Sprint 8)
#
# LLM_PROVIDER selects the LLM provider:
#   - "mock"             -> MockLLMProvider (default, no API key, no cost)
#   - "openai_compatible"-> OpenAICompatibleProvider (configurable below)
#
# The project is fully usable at zero cost with the mock provider: no API
# key, no network, no downloaded models.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=mock
# LLM_MODEL=your_openai_compatible_model_name
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
#
# Context budget for retrieved code (tokens) applied by the PromptBuilder.
# Approximate; converted to characters via a ~4 chars/token heuristic.
# LLM_CONTEXT_BUDGET_TOKENS=2000
#
# Minimum normalized relevance (0..1) for a retrieved result to count as
# usable context in the RAGService. Below this, the service returns an
# explicit insufficient-context response instead of fabricating context.
# RAG_MIN_RELEVANCE=0.55

# ---------------------------------------------------------------------------
# Vector Store Configuration
# ---------------------------------------------------------------------------
# CHROMA_PERSIST_DIR=./chroma_db
# COLLECTION_NAME=codepilot